		<style id="wp-custom-css">
			html{
	scroll-behavior: smooth;
}

.line-clamp-2, .line-clamp-2 p, .line-clamp-2 .elementor-widget-container, .line-clamp-2 .elementor-heading-title {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.header-wrapper {
  background: rgb(255 255 255 / 10%);
  -webkit-backdrop-filter: blur(4px) brightness(1.5);
  backdrop-filter: blur(4px) brightness(1.4);
  border-bottom: 1px solid #f3f3f3;
}


.product-card-info .elementor-post-info__terms-list-item {
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    align-items: center;
    color: #1D4ED8;
    background: #DBEAFE;
    border-radius: 99px;
    padding: 6px 12px 6px 12px;
}

.industry-card:not(:hover) .elementor-cta__bg-overlay { background: linear-gradient(0deg, rgba(30, 58, 138, 0.6) 0%, rgba(30, 58, 138, 0) 50%, rgba(30, 58, 138, 0) 100%) !important;
} 

.industry-card:hover .elementor-cta__bg-overlay { background: linear-gradient(to top, rgba(8, 145, 178, 0.7), rgba(8, 145, 178, 0)) !important; }

.bg-gradient {
	background: linear-gradient(162deg, #3b82f6 0%, #06b6d4 50%, #2563eb 100%) !important;
}


/* Single Product Page CSS */
.single-product-info li {
    background: linear-gradient(90deg, #3B82F6 0%, #06B6D4 100%);
    border-radius: 9999px;
    padding: 6px 14px !important;
}

.single-features-icon .elementor-icon {
    background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
}

.optional-features-icon .elementor-icon {
    background: linear-gradient(135deg, #06B6D4 0%, #0891B2 100%);
}

@media (max-width:767px){
	.single-product-info ul {
    row-gap: 12px !important;
}
}
/* Single Product Page CSS End */



.text-highlight {
    background: linear-gradient(135deg, #3B82F6 0%, #06B6D4 50%, #2563EB 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; text-fill-color: transparent;
    filter: drop-shadow(0 2px 4px #00000036);
}

.text-highlight.no-shadow{
	 filter: none !important;
}

.logos-slider .swiper-wrapper {
  transition-timing-function: linear !important; 
}
.logos-slider .swiper-slide {
    display: flex;
    padding: 16px;
    background: white;
    border: 2px solid #F3F4F6;
    border-radius: 8px;
    align-items: center;
    flex-shrink: 0;
    min-height: 128px;
    height: 100%;
    justify-content: center;
    box-shadow: 0 4px 6px -1px #0000001a,0 2px 4px -2px #0000001a;
}

.logos-slider .swiper-slide-image {
    width: 100%;
    max-width: 100%;
    max-height: 5rem;
    object-fit: contain;
}
.logos-slider .swiper-slide {
  transition: all 0.6s ease;
}
.logos-slider *{
    overflow: visible !important;
}
.logos-slider .swiper-slide:hover {
  transform: scale(1.1);
  border: 3px solid #06b6d4;
  box-shadow: 0 25px 50px -12px #00000040;
  transform-origin: bottom;
}

.feature-box:hover {
    background: rgb(255 255 255 / 10%);
}


.industry-card .elementor-cta__content {
    overflow: visible;
}
.industry-card .elementor-cta__title {
    margin-top: -60px;
}



/* Product Archive Page CSS */
/* Dynamic Machine Type Menu */
.machine-type-item {
    background-color: transparent;
    background-image: linear-gradient(180deg, #FFFFFF 0%, #FFFFFF 100%);
    padding: 12px 20px 12px 20px;
    border: 1px solid #E5E5E5;
    border-radius: 12px;
    color: #111827 !important;
    font-weight: 600;
    text-transform: uppercase;
	  transition: all .3s linear;
		line-height: normal;
}

.machine-type-item:hover {
    background-color: transparent;
    background-image: linear-gradient(180deg, #FFFFFF 0%, #F8F8F8 100%);
    border: 1px solid #2792D0;
}

.machine-type-item.active {
    background: linear-gradient(90deg, #3B82F6 0%, #06B6D4 100%);
    color: #ffffff !important;
}

.machine-types-list {
    align-items: center;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    overflow-x: initial;
    -ms-overflow-style: none;
    scrollbar-width: none;
}


@media (max-width: 767px){
	.machine-type-item {
    padding: 12px 12px 12px 12px;
		font-size: 12px;
		flex-shrink: 0;
		border-radius: 8px;
	}
	.machine-types-list {
    flex-wrap: nowrap;
    gap: 12px;
    justify-content: flex-start;
    overflow-x: scroll;
    -ms-overflow-style: none;
    scrollbar-width: none;
	}
		
		body:not(.elementor-editor-active) .slider-cards-wrapper .product {
    width: 100%;
    max-width: 300px;
    flex-shrink: 0;
	}
	
	 body:not(.elementor-editor-active) .slider-cards-wrapper .industry-card {
    width: 100%;
    max-width: 290px !important;
    flex-shrink: 0;
	}
		
		body:not(.elementor-editor-active) .slider-cards-wrapper .elementor-loop-container, body:not(.elementor-editor-active) .industry-cards-wrapper .e-con-inner{
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
	}
	body:not(.elementor-editor-active) .industry-cards-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
		padding-left: 20px;
		padding-right: 20px;
	}
		body:not(.elementor-editor-active) .slider-cards-wrapper {
    overflow-x: scroll;
		scroll-snap-type: x;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.product-card-info .elementor-post-info__terms-list-item {
    font-size: 12px;
    line-height: 16px;
    color: #1D4ED8;
    background: #DBEAFE;
    border-radius: 99px;
    padding: 6px 12px 6px 12px;
}
}		</style>
		</head>
